{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacClone",
  "version": "0.1.1",
  "identifier": "org.macclone.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MacClone",
        "label": "main",
        "width": 1140,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "publisher": "Starlit Studios",
    "copyright": "Copyright © 2026 Starlit Studios",
    "shortDescription": "Windows için macOS disk klonlama, RAW imaj ve doğrulama aracı",
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
